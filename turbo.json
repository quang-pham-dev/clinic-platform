{
  "$schema": "https://turbo-2-8-20.turborepo.com/schema.json",
  "globalDependencies": [],
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "PORT",
    "API_PREFIX",
    "CORS_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "STRAPI_URL",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DB_USER",
    "DB_PASSWORD",
    "DB_LOGGING",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "REVALIDATION_SECRET",
    "STRAPI_WEBHOOK_SECRET",
    "STRAPI_API_TOKEN",
    "NEXTJS_MEMBER_URL",
    "DEV",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_BASIC_MONTHLY_PRICE_ID",
    "STRIPE_BASIC_ANNUAL_PRICE_ID",
    "STRIPE_PRO_MONTHLY_PRICE_ID",
    "STRIPE_PRO_ANNUAL_PRICE_ID",
    "STRIPE_ENTERPRISE_MONTHLY_PRICE_ID",
    "STRIPE_ENTERPRISE_ANNUAL_PRICE_ID",
    "FRONTEND_URL",
    "NEXT_PUBLIC_API_WS_URL",
    "CLINIC_API_URL",
    "STRAPI_SEED_DOCTOR_PAGES",
    "STRAPI_SEED_CONTENT",
    "NESTJS_WEBHOOK_URL",
    "VITE_API_BASE_URL",
    "VITE_API_PROXY_TARGET"
  ],
  "globalPassThroughEnv": ["CI"],
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["dist/**", "build/**"]
    },
    "format": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".prettierrc*", "prettier.config.*"]
    },
    "format:fix": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*", ".eslintignore"]
    },
    "lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    }
  }
}
