{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ",
    "description": "Frequently asked questions grouped by category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "richtext",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "booking",
        "video-call",
        "medical-records",
        "account",
        "general"
      ],
      "required": true
    },
    "order": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
